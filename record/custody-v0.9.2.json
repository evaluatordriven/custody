      "author": "Claude Opus 5.5",
      "dimensions": [
        {
          "id": "D1",
          "criterion": "Cold record creation: participants with no prior exposure produce CL1 records matching the answer key",
          "scale": null
        },
        {
          "id": "D2",
          "criterion": "Reviewer-verifiable: a reader who did not implement assigns verdict, level and governing requirement matching the answer key",
          "scale": null
        },
        {
          "id": "D3",
          "criterion": "Quickstart: the README's first section states what, who, status and limits; the quickstart runs on clean Python >= 3.10",
          "scale": null
        },
        {
          "id": "D4",
          "criterion": "Size budget: normative words, key words, terms and checker lines within the limits",
          "scale": null
        },
        {
          "id": "D5",
          "criterion": "One home, clearly separated: key words only in normative sections; no term defined twice; no two files contradict",
          "scale": null
        },
        {
          "id": "D6",
          "criterion": "Faithful to the site's commitments: every Appendix B item maps to a dispositioned Appendix A row",
          "scale": null
        },
        {
          "id": "D7",
          "criterion": "Every requirement has an evidence path: a check class and an outcome when evidence is missing",
          "scale": null
        },
        {
          "id": "D8",
          "criterion": "Levels are red-first: fixtures fail each level for one named reason; the schema is verified by a third-party validator",
          "scale": null
        },
        {
          "id": "D9",
          "criterion": "Checker correct against the answer key on every held-out case",
          "scale": null
        },
        {
          "id": "D10",
          "criterion": "Honest front matter: no adoption claims; licenses and self-state match the repository",
          "scale": null
        },
        {
          "id": "D11",
          "criterion": "Dogfooded, with a digest boundary: the release carries this job's own custody/v1 record, verified at CL1",
          "scale": null
        },
